#!/bin/sh

# Apache Maven Wrapper startup script, compatible with Maven Wrapper 3.3.4 only-script mode.
# Licensed under the Apache License, Version 2.0.

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

native_path() { printf '%s\n' "$1"; }
case "$(uname)" in
  CYGWIN* | MINGW*)
    [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
    native_path() { cygpath --path --windows "$1"; }
    ;;
esac

set_java_home() {
  if [ -n "${JAVA_HOME-}" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
      JAVACMD="$JAVA_HOME/jre/sh/java"
      JAVACCMD="$JAVA_HOME/jre/sh/javac"
    else
      JAVACMD="$JAVA_HOME/bin/java"
      JAVACCMD="$JAVA_HOME/bin/javac"
      if [ ! -x "$JAVACMD" ] || [ ! -x "$JAVACCMD" ]; then
        echo "JAVA_HOME is not defined correctly, so mvnw cannot run." >&2
        return 1
      fi
    fi
  else
    JAVACMD="$(command -v java 2>/dev/null || :)"
    JAVACCMD="$(command -v javac 2>/dev/null || :)"
    if [ ! -x "${JAVACMD-}" ] || [ ! -x "${JAVACCMD-}" ]; then
      echo "java/javac is not available in PATH and JAVA_HOME is not set." >&2
      return 1
    fi
  fi
}

hash_string() {
  str="${1:-}" h=0
  while [ -n "$str" ]; do
    char="${str%"${str#?}"}"
    h=$(((h * 31 + $(LC_CTYPE=C printf %d "'$char")) % 4294967296))
    str="${str#?}"
  done
  printf '%x\n' "$h"
}

verbose() { :; }
[ "${MVNW_VERBOSE-}" != true ] || verbose() { printf '%s\n' "${1-}"; }
die() { printf '%s\n' "$1" >&2; exit 1; }
trim() { printf '%s' "$1" | tr -d '[:space:]'; }

scriptDir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
scriptName="$(basename "$0")"

while IFS="=" read -r key value; do
  case "${key-}" in
    distributionUrl) distributionUrl=$(trim "${value-}") ;;
    distributionSha256Sum) distributionSha256Sum=$(trim "${value-}") ;;
  esac
done <"$scriptDir/.mvn/wrapper/maven-wrapper.properties"

[ -n "${distributionUrl-}" ] || die "cannot read distributionUrl property in $scriptDir/.mvn/wrapper/maven-wrapper.properties"
MVN_CMD="mvn${scriptName#mvnw}"
_MVNW_REPO_PATTERN=/org/apache/maven/
[ -z "${MVNW_REPOURL-}" ] || distributionUrl="$MVNW_REPOURL$_MVNW_REPO_PATTERN${distributionUrl#*"$_MVNW_REPO_PATTERN"}"

distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
distributionUrlNameMain="${distributionUrlNameMain%-bin}"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${distributionUrlNameMain}/$(hash_string "$distributionUrl")"

exec_maven() {
  unset MVNW_VERBOSE MVNW_USERNAME MVNW_PASSWORD MVNW_REPOURL || :
  exec "$MAVEN_HOME/bin/$MVN_CMD" "$@" || die "cannot exec $MAVEN_HOME/bin/$MVN_CMD"
}

if [ -d "$MAVEN_HOME" ]; then
  verbose "found existing MAVEN_HOME at $MAVEN_HOME"
  exec_maven "$@"
fi

case "${distributionUrl-}" in
  *?-bin.zip) ;;
  *) die "distributionUrl is not valid, must end with *-bin.zip, but found '${distributionUrl-}'" ;;
esac

TMP_DOWNLOAD_DIR="$(mktemp -d)" || die "cannot create temp dir"
clean() { rm -rf -- "$TMP_DOWNLOAD_DIR"; }
trap clean HUP INT TERM EXIT
mkdir -p -- "${MAVEN_HOME%/*}"

if ! command -v unzip >/dev/null; then
  distributionUrl="${distributionUrl%.zip}.tar.gz"
  distributionUrlName="${distributionUrl##*/}"
fi

verbose "Downloading Maven from: $distributionUrl"

if [ -z "${MVNW_USERNAME-}" ] && command -v wget >/dev/null; then
  wget ${MVNW_VERBOSE:+} "$distributionUrl" -O "$TMP_DOWNLOAD_DIR/$distributionUrlName" || die "wget: Failed to fetch $distributionUrl"
elif [ -z "${MVNW_USERNAME-}" ] && command -v curl >/dev/null; then
  curl -f -L -o "$TMP_DOWNLOAD_DIR/$distributionUrlName" "$distributionUrl" || die "curl: Failed to fetch $distributionUrl"
elif set_java_home; then
  javaSource="$TMP_DOWNLOAD_DIR/Downloader.java"
  targetArchive="$TMP_DOWNLOAD_DIR/$distributionUrlName"
  cat >"$javaSource" <<'JAVA'
public class Downloader extends java.net.Authenticator {
    protected java.net.PasswordAuthentication getPasswordAuthentication() {
        String username = System.getenv("MVNW_USERNAME");
        String password = System.getenv("MVNW_PASSWORD");
        return new java.net.PasswordAuthentication(username == null ? "" : username,
                password == null ? new char[0] : password.toCharArray());
    }
    public static void main(String[] args) throws Exception {
        setDefault(new Downloader());
        java.nio.file.Files.copy(java.net.URI.create(args[0]).toURL().openStream(),
                java.nio.file.Paths.get(args[1]).toAbsolutePath().normalize());
    }
}
JAVA
  "$(native_path "$JAVACCMD")" "$(native_path "$javaSource")" || die "Failed to compile Downloader.java"
  "$(native_path "$JAVACMD")" -cp "$(native_path "$TMP_DOWNLOAD_DIR")" Downloader "$distributionUrl" "$(native_path "$targetArchive")"
else
  die "No supported download mechanism is available (wget, curl, or Java)."
fi

if [ -n "${distributionSha256Sum-}" ]; then
  if command -v sha256sum >/dev/null; then
    echo "$distributionSha256Sum $TMP_DOWNLOAD_DIR/$distributionUrlName" | sha256sum -c - >/dev/null 2>&1 || die "Maven distribution SHA-256 validation failed"
  elif command -v shasum >/dev/null; then
    echo "$distributionSha256Sum $TMP_DOWNLOAD_DIR/$distributionUrlName" | shasum -a 256 -c >/dev/null 2>&1 || die "Maven distribution SHA-256 validation failed"
  else
    die "Checksum validation requested but neither sha256sum nor shasum is available"
  fi
fi

if command -v unzip >/dev/null; then
  unzip -q "$TMP_DOWNLOAD_DIR/$distributionUrlName" -d "$TMP_DOWNLOAD_DIR" || die "failed to unzip Maven"
else
  tar xzf "$TMP_DOWNLOAD_DIR/$distributionUrlName" -C "$TMP_DOWNLOAD_DIR" || die "failed to untar Maven"
fi

actualDistributionDir=""
if [ -f "$TMP_DOWNLOAD_DIR/$distributionUrlNameMain/bin/$MVN_CMD" ]; then
  actualDistributionDir="$distributionUrlNameMain"
else
  set +f
  for dir in "$TMP_DOWNLOAD_DIR"/*; do
    if [ -d "$dir" ] && [ -f "$dir/bin/$MVN_CMD" ]; then
      actualDistributionDir="$(basename "$dir")"
      break
    fi
  done
  set -f
fi

[ -n "$actualDistributionDir" ] || die "Could not find Maven distribution directory in extracted archive"
printf '%s\n' "$distributionUrl" >"$TMP_DOWNLOAD_DIR/$actualDistributionDir/mvnw.url"
mv -- "$TMP_DOWNLOAD_DIR/$actualDistributionDir" "$MAVEN_HOME" || [ -d "$MAVEN_HOME" ] || die "failed to move MAVEN_HOME"
clean || :
trap - HUP INT TERM EXIT
exec_maven "$@"
